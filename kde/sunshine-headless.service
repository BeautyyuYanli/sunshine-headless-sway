[Unit]
Description=Isolated Sunshine, Sway and audio session
After=graphical-session.target
Conflicts=app-dev.lizardbyte.app.Sunshine.service sunshine1.service

[Service]
Type=simple
RuntimeDirectory=sunshine-headless
RuntimeDirectoryMode=0700
Environment=HOST_DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStartPre=%h/.local/share/sunshine-headless/input-isolation.py disable
ExecStart=/usr/bin/dbus-run-session -- %h/.local/share/sunshine-headless/session.py run
ExecStopPost=%h/.local/share/sunshine-headless/input-isolation.py restore
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=default.target
